{
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-run --allow-env bin/exif-importer.ts",
    "test": "deno run --allow-read --allow-write --allow-run --allow-env bin/exif-importer.ts --dir sample",
    "lint": "deno lint",
    "format": "deno fmt",
    "check": "deno check bin/exif-importer.ts"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": ["lib/", "bin/"]
  },
  "lint": {
    "include": ["lib/", "bin/"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "imports": {
    "date-fns": "npm:date-fns@^4.1.0",
    "xml2js": "npm:xml2js@^0.6.2",
    "@std/path": "jsr:@std/path@^1"
  },
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true
  }
}
