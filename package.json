{
  "name": "exif-importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "exif-importer": "./bin/exif-importer.ts"
  },
  "scripts": {
    "start": "bun bin/exif-importer.ts",
    "sample": "bun bin/exif-importer.ts --dir sample",
